#!/usr/bin/env bash
set -e

echo "Running pre-commit checks..."

echo ""
echo "==> Pint (code style)"
vendor/bin/pint --test

echo ""
echo "==> PHPStan (static analysis)"
vendor/bin/phpstan analyse

echo ""
echo "==> PHPMD (complexity)"
# Suppress PHP 8.4 E_DEPRECATED notices emitted by the phpmd/pdepend vendor code
# (implicit-nullable params). Real violations still set a non-zero exit code.
php -d error_reporting='E_ALL & ~E_DEPRECATED' vendor/bin/phpmd src,generator/src text phpmd.xml

echo ""
echo "==> Generated code is up to date"
php generator/bin/generate --check

echo ""
echo "==> Pest (tests, 100% coverage)"
php -d pcov.directory=. -d 'pcov.exclude=~(vendor|tests)~' vendor/bin/pest --coverage --min=100

echo ""
echo "==> Pest (100% type coverage)"
vendor/bin/pest --type-coverage --min=100

echo ""
echo "All checks passed."
