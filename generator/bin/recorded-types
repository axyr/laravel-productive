#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Writes generator/recorded-types.json from a `composer record` run (the latest by default):
 * value kinds, relationships, rejected includes and statuses. No values, so it is safe to commit.
 */

use Axyr\Productive\Generator\Recording\RecordingSummary;

require __DIR__ . '/../../vendor/autoload.php';

$root = dirname(__DIR__, 2);
$runs = glob($root . '/recordings/*', GLOB_ONLYDIR) ?: [];
rsort($runs);
$directory = $argv[1] ?? ($runs[0] ?? null);

if ($directory === null || ! is_dir($directory)) {
    fwrite(STDERR, "No recordings found: run `composer record` first.\n");
    exit(1);
}

$recordings = [];

foreach (glob($directory . '/*.json') ?: [] as $file) {
    $recordings[basename($file, '.json')] = json_decode((string) file_get_contents($file), true, flags: JSON_THROW_ON_ERROR);
}

$summary = ['recorded_on' => substr(basename($directory), 0, 10), ...(new RecordingSummary())->summarize($recordings)];
file_put_contents($root . '/generator/recorded-types.json', json_encode($summary, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");

echo 'Summarized ' . count($recordings) . ' recordings from ' . basename($directory) . " into generator/recorded-types.json.\n";
