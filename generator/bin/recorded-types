#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Writes generator/recorded-types.json from a `composer record` run (the latest by default) and
 * every finished `composer record:writes` run: value kinds, relationships, rejected includes,
 * statuses and the attributes a write answered "can't be blank" for. No values, so it is safe to
 * commit.
 */

use Axyr\Productive\Generator\Recording\RecordingSummary;

require __DIR__ . '/../../vendor/autoload.php';

$root = dirname(__DIR__, 2);
// Finished recording runs only: named by date and marked complete. Seed logs and runs that are
// still going or stopped on a 429 are skipped.
$runs = array_map(dirname(...), glob($root . '/recordings/[0-9]*/.complete') ?: []);
rsort($runs);
$directory = $argv[1] ?? ($runs[0] ?? null);

if ($directory === null || ! is_dir($directory)) {
    fwrite(STDERR, "No recordings found: run `composer record` first.\n");
    exit(1);
}

$recordings = [];

foreach (glob($directory . '/*.json') ?: [] as $file) {
    $recordings[basename($file, '.json')] = json_decode((string) file_get_contents($file), true, flags: JSON_THROW_ON_ERROR);
}

$writes = array_map(dirname(...), glob($root . '/recordings/writes-*/.complete') ?: []);

foreach ($writes as $run) {
    foreach (glob($run . '/*.json') ?: [] as $file) {
        $recordings[basename($run) . '/' . basename($file, '.json')] = json_decode((string) file_get_contents($file), true, flags: JSON_THROW_ON_ERROR);
    }
}

// Laid over the committed summary, which may hold runs made on another machine: a recording adds
// or retypes, and never removes what an earlier one found.
$file = $root . '/generator/recorded-types.json';
$previous = is_file($file) ? json_decode((string) file_get_contents($file), true, flags: JSON_THROW_ON_ERROR) : [];
$summary = ['recorded_on' => substr(basename($directory), 0, 10), ...RecordingSummary::merge(is_array($previous) ? $previous : [], (new RecordingSummary())->summarize($recordings))];
file_put_contents($file, json_encode($summary, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");

echo 'Summarized ' . count($recordings) . ' recordings from ' . basename($directory) . ' and ' . count($writes) . " write runs into generator/recorded-types.json.\n";
