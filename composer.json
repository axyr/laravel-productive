{
    "name": "axyr/laravel-productive",
    "description": "Laravel SDK for the Productive.io API",
    "type": "library",
    "keywords": [
        "laravel",
        "productive",
        "productive.io",
        "sdk",
        "api",
        "json-api"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Martijn van Nieuwenhoven",
            "email": "info@axyrmedia.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/pagination": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpmd/phpmd": "^2.15",
        "symfony/process": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Axyr\\Productive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Axyr\\Productive\\Generator\\": "generator/src/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "php -d pcov.directory=. -d 'pcov.exclude=~(vendor|tests)~' vendor/bin/pest --coverage --min=100",
        "test:types": "pest --type-coverage --min=100",
        "test:mutate": "php -d pcov.directory=. -d 'pcov.exclude=~(vendor|tests)~' vendor/bin/pest --mutate --everything --covered-only --no-cache --min=100",
        "test:arch": "pest --testsuite=Arch",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test",
        "complexity": "php -d error_reporting='E_ALL & ~E_DEPRECATED' vendor/bin/phpmd src,generator/src text phpmd.xml",
        "quality": [
            "@format:test",
            "@analyse",
            "@complexity",
            "@generate:check",
            "@test:coverage",
            "@test:types"
        ],
        "post-install-cmd": [
            "@install-hooks"
        ],
        "post-update-cmd": [
            "@install-hooks"
        ],
        "install-hooks": [
            "bash -c 'if [ -d .git ]; then git config core.hooksPath .githooks && echo \"Pre-commit hook configured (core.hooksPath=.githooks)\"; fi'"
        ],
        "generate:ir": "php generator/bin/ir > generator/api.json",
        "generate": "php generator/bin/generate",
        "generate:check": "php generator/bin/generate --check",
        "generate:manifest": "php generator/bin/manifest > generator/full-api.sha1.json"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Axyr\\Productive\\ProductiveServiceProvider"
            ],
            "aliases": {
                "Productive": "Axyr\\Productive\\ProductiveFacade"
            }
        }
    }
}
