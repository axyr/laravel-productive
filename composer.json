{
    "name": "axyr/laravel-productive",
    "description": "Laravel SDK for the Productive.io API",
    "type": "library",
    "keywords": ["laravel", "productive", "productive.io", "sdk", "api", "json-api"],
    "license": "MIT",
    "authors": [
        {
            "name": "Martijn van Nieuwenhoven",
            "email": "info@axyrmedia.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/pagination": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpmd/phpmd": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "Axyr\\Productive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=100",
        "test:types": "pest --type-coverage --min=100",
        "test:mutate": "pest --mutate --everything --covered-only --min=100",
        "test:arch": "pest --testsuite=Arch",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test",
        "complexity": "php -d error_reporting='E_ALL & ~E_DEPRECATED' vendor/bin/phpmd src text phpmd.xml",
        "quality": [
            "@format:test",
            "@analyse",
            "@complexity",
            "@test:coverage",
            "@test:types"
        ],
        "post-install-cmd": [
            "@install-hooks"
        ],
        "post-update-cmd": [
            "@install-hooks"
        ],
        "install-hooks": [
            "bash -c 'if [ -d .git ]; then git config core.hooksPath .githooks && echo \"Pre-commit hook configured (core.hooksPath=.githooks)\"; fi'"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Axyr\\Productive\\ProductiveServiceProvider"
            ],
            "aliases": {
                "Productive": "Axyr\\Productive\\ProductiveFacade"
            }
        }
    }
}
